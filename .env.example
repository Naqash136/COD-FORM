# Copy this file to .env and replace the placeholders.
# Do not commit .env. Shopify CLI also writes SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SCOPES, and SHOPIFY_APP_URL into .env for local development.

# Runtime connection used by Prisma Client.
# Supabase Dashboard → Connect → Transaction pooler (port 6543).
# The pooler username is postgres.[PROJECT-REF], not postgres.
# Percent-encode the database password once. @ becomes %40 and % becomes %25.
# pgbouncer=true disables prepared statements, which transaction mode does not support.
# The application verifies this certificate itself. Prisma's engine does not read
# sslrootcert, and its default sslaccept=accept_invalid_certs does not validate it.
# app/db.server.ts connects with node-postgres, rejectUnauthorized, and this CA file.
# Add connection_limit=1 only for serverless runtimes. Railway is a long-running server,
# so leave Prisma's default pool unless the Supabase pool size is being exhausted.
# connect_timeout=30 gives Prisma Migrate time to finish TCP + TLS + auth on high-latency links.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=60"

# Used only by Prisma Migrate (schema directUrl). Do not use the transaction pooler here.
# This is the shared session pooler on port 5432, which supports migrations over IPv4.
# Use the same percent-encoded password.
# On Linux, sslcert is resolved relative to the prisma directory and sslaccept=strict
# makes Prisma validate the server certificate against certs/prod-ca-2021.crt.
# Do not set sslaccept=accept_invalid_certs.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=strict&sslcert=../certs/prod-ca-2021.crt&connect_timeout=30"

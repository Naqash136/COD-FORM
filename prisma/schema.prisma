// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum ShopStatus {
  ACTIVE
  UNINSTALLED
}

enum LoginEventType {
  INSTALL
  REINSTALL
  LOGIN
  APP_ACCESS
  UNINSTALL
}

model Shop {
  id              String     @id @default(uuid()) @db.Uuid
  shopifyShopId   String     @unique
  shopDomain      String     @unique
  shopName        String
  email           String?
  ownerName       String?
  phone           String?
  countryCode     String?
  currency        String
  timezone        String
  shopifyPlan     String?
  status          ShopStatus @default(ACTIVE)
  installedAt     DateTime   @default(now())
  lastInstalledAt DateTime   @default(now())
  uninstalledAt   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  loginHistory    LoginHistory[]
  bundleOffers    BundleOffer[]

  @@index([status])
}

model LoginHistory {
  id            String         @id @default(uuid()) @db.Uuid
  shopId        String         @db.Uuid
  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyUserId String?
  eventType     LoginEventType
  createdAt     DateTime       @default(now())

  @@index([shopId, createdAt])
  @@index([shopId, shopifyUserId, createdAt])
  @@index([createdAt])
}

enum BundleOfferStatus {
  DRAFT
  PUBLISHED
  INACTIVE
}

/// Merchant-owned bundle configuration.
/// storefrontActive and codFormActive stay false until a later activation step.
/// Publication only moves publishedRevisionId and status. The migration CHECK
/// rejects activation unless status is PUBLISHED and publishedRevisionId is set.
/// A trigger rejects revision pointers that belong to another offer or merchant.
/// Prisma cannot model that CHECK or the triggers; they live in the SQL migration.
model BundleOffer {
  id                  String            @id @default(uuid()) @db.Uuid
  shopId              String            @db.Uuid
  shop                Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name                String
  status              BundleOfferStatus @default(DRAFT)
  storefrontActive    Boolean           @default(false)
  codFormActive       Boolean           @default(false)
  draftRevisionId     String?           @unique @db.Uuid
  publishedRevisionId String?           @unique @db.Uuid
  draftRevision       BundleRevision?   @relation("BundleDraftRevision", fields: [draftRevisionId], references: [id], onDelete: SetNull)
  publishedRevision   BundleRevision?   @relation("BundlePublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions           BundleRevision[]  @relation("BundleOfferRevisions")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([shopId, status])
  @@index([shopId, updatedAt])
}

/// Immutable snapshot. The migration rejects UPDATE. Saving a draft inserts a row.
model BundleRevision {
  id             String       @id @default(uuid()) @db.Uuid
  offerId        String       @db.Uuid
  offer          BundleOffer  @relation("BundleOfferRevisions", fields: [offerId], references: [id], onDelete: Cascade)
  shopId         String       @db.Uuid
  schemaVersion  Int
  document       Json
  createdAt      DateTime     @default(now())
  draftOffer     BundleOffer? @relation("BundleDraftRevision")
  publishedOffer BundleOffer? @relation("BundlePublishedRevision")

  @@index([offerId, createdAt])
  @@index([shopId])
}
